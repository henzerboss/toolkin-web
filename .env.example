# ─── База ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/toolkin

# ─── Модель ──────────────────────────────────────────────────────────────────
# Ключ живёт только здесь. В приложении его нет и быть не должно.
TOOLKIN_GEMINI_API_KEY=
TOOLKIN_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
TOOLKIN_TEMPERATURE=0.4
TOOLKIN_MAX_OUTPUT_TOKENS=8192
# Сколько раз пытаться починить невалидную спеку, прежде чем сдаться.
TOOLKIN_MAX_REPAIRS=2

# ─── Доступ ──────────────────────────────────────────────────────────────────
# Общий секрет с приложением: EXPO_PUBLIC_TOOLKIN_CLIENT_TOKEN.
# Не защищает от реверса клиента, но отсекает случайных ботов.
TOOLKIN_CLIENT_TOKEN=
# Запросов с одного IP в час.
TOOLKIN_RATE_LIMIT=120

# ─── Кредиты ─────────────────────────────────────────────────────────────────
TOOLKIN_COST_GENERATE=5
TOOLKIN_COST_REFINE=2
TOOLKIN_COST_ASK=1
# Выдаются один раз на устройство, а не ежемесячно: их задача — довести
# человека до момента «работает», дальше пейволл.
TOOLKIN_FREE_GENERATIONS=4
# Начисляется на каждое продление подписки.
TOOLKIN_SUBSCRIPTION_CREDITS=400
# product_id из RevenueCat : сколько кредитов даёт пакет
TOOLKIN_CREDIT_PACKS=credits_100:100,credits_500:550,credits_1200:1400

# ─── RevenueCat ──────────────────────────────────────────────────────────────
# Значение заголовка Authorization, заданное в дашборде рядом с URL вебхука.
TOOLKIN_REVENUECAT_WEBHOOK_SECRET=
# true — начислять кредиты и за sandbox-покупки. Только для отладки.
TOOLKIN_ALLOW_SANDBOX=false

# ─── Версии в сторах ─────────────────────────────────────────────────────────
# MIN_VERSION включает блокирующий экран «обновитесь» — нужен, только если
# сломан контракт API. В обычной ситуации оставляйте пустым.
TOOLKIN_IOS_LATEST_VERSION=1.0.0
TOOLKIN_IOS_MIN_VERSION=
TOOLKIN_IOS_STORE_URL=
TOOLKIN_IOS_RELEASE_NOTES=
TOOLKIN_ANDROID_LATEST_VERSION=1.0.0
TOOLKIN_ANDROID_MIN_VERSION=
TOOLKIN_ANDROID_STORE_URL=
TOOLKIN_ANDROID_RELEASE_NOTES=
