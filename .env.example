# ─── База ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/toolkin

# ─── Модель ──────────────────────────────────────────────────────────────────
# Ключ живёт только здесь. В приложении его нет и быть не должно.
TOOLKIN_GEMINI_API_KEY=
TOOLKIN_PLAN_SECRET=
# Доступность моделей меняется со временем и может различаться для ключей.
# Актуальный список для своего ключа:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=КЛЮЧ" | grep '"name"'
# Проверить, что бэкенд их видит: GET /api/health
# Каскад по умолчанию. Ниже можно переопределить его для каждой задачи:
# генерация редкая и требовательная — ей старшую модель, ответы внутри утилит
# массовые и простые — им быструю. Списки перебираются по очереди при отказе.
TOOLKIN_MODELS=gemini-3.6-flash,gemini-3.5-flash
TOOLKIN_MODELS_PLAN=gemini-3.6-flash,gemini-3.5-flash-lite
TOOLKIN_MODELS_GENERATE=gemini-3.6-flash,gemini-3.5-flash
TOOLKIN_MODELS_REFINE=gemini-3.6-flash,gemini-3.5-flash
TOOLKIN_MODELS_ASK=gemini-3.5-flash-lite
TOOLKIN_MODELS_VERIFY=gemini-3.5-flash-lite,gemini-3.5-flash
TOOLKIN_MODELS_TRANSLATE=gemini-3.5-flash-lite
# Уровень размышления: minimal | low | medium | high. Для сложной сборки
# используем medium: Product Plan уже зафиксировал архитектуру, а high заметно
# увеличивает latency. Flash-Lite оставлен для узких высокочастотных задач.
# Температуры здесь нет намеренно: Gemini 3 её игнорирует.
TOOLKIN_THINKING_PLAN=medium
TOOLKIN_THINKING_GENERATE=medium
TOOLKIN_THINKING_REFINE=medium
TOOLKIN_THINKING_ASK=low
TOOLKIN_THINKING_VERIFY=low
# Output budget is per task: Spec v2 can be much larger than the old 8k envelope.
TOOLKIN_MAX_OUTPUT_TOKENS_PLAN=6144
TOOLKIN_MAX_OUTPUT_TOKENS_GENERATE=32768
TOOLKIN_MAX_OUTPUT_TOKENS_REFINE=32768
TOOLKIN_MAX_OUTPUT_TOKENS_ASK=4096
TOOLKIN_MAX_OUTPUT_TOKENS_VERIFY=4096
TOOLKIN_MAX_OUTPUT_TOKENS_TRANSLATE=2048
# Сколько раз пытаться починить невалидную спеку, прежде чем сдаться.
TOOLKIN_MAX_REPAIRS=2
# Один запрос на модель, затем fallback-модель. Повторять один и тот же 5xx/timeout
# внутри модели нет смысла: это только удлиняет job.
TOOLKIN_ATTEMPTS_PER_MODEL=1
# Максимум fallback-моделей в одном вызове. Даже если старый .env содержит
# три модели, production pipeline не должен растягиваться на три таймаута подряд.
TOOLKIN_MAX_MODELS_PER_CALL=2
# Жёсткий timeout одного вызова Gemini. Вся генерация теперь job-based, поэтому
# мобильное HTTPS-соединение от этой величины не зависит.
TOOLKIN_AI_REQUEST_TIMEOUT_MS=90000
# Never expose validator/provider internals to end users. Enable briefly only while debugging.
TOOLKIN_DEBUG_ERRORS=false

# Кэш готовых спек. Одинаковые запросы — а примеры-затравки на экране создания
# одинаковы у всех — не должны оплачиваться повторно. false отключает.
TOOLKIN_SPEC_CACHE=true

# ─── Доступ ──────────────────────────────────────────────────────────────────
# Общий секрет с приложением: EXPO_PUBLIC_TOOLKIN_CLIENT_TOKEN.
# Не защищает от реверса клиента, но отсекает случайных ботов.
TOOLKIN_CLIENT_TOKEN=
# Запросов с одного IP в час.
TOOLKIN_RATE_LIMIT=120

# ─── Кредиты ─────────────────────────────────────────────────────────────────
TOOLKIN_COST_GENERATE=5
TOOLKIN_COST_REFINE=2
TOOLKIN_COST_ASK=1
TOOLKIN_COST_IMAGE=3

# Генерация картинок: FLUX-1-schnell на DeepInfra. Без ключа роут /api/image
# отвечает 501, а утилиты с capability "image" просто не будут создаваться.
TOOLKIN_DEEPINFRA_API_KEY=
TOOLKIN_DEEPINFRA_IMAGE_MODEL=black-forest-labs/FLUX-1-schnell
TOOLKIN_DEEPINFRA_IMAGE_SIZE=1024x1024
TOOLKIN_DEEPINFRA_IMAGE_STEPS=4
# Перевод промпта на английский перед отправкой в FLUX. Модель не понимает
# другие языки и молча выдаёт мусор, поэтому по умолчанию включено.
TOOLKIN_IMAGE_TRANSLATE=true
# Приветственные кредиты: выдаются один раз при первом запуске.
# 30 — это шесть созданий или четыре создания с правками.
TOOLKIN_WELCOME_CREDITS=30
# Начисляется на каждое продление подписки.
TOOLKIN_SUBSCRIPTION_CREDITS=400
# product_id из RevenueCat : сколько кредитов даёт пакет
TOOLKIN_CREDIT_PACKS=credits_100:100,credits_500:550,credits_1200:1400

# ─── RevenueCat ──────────────────────────────────────────────────────────────
# Значение заголовка Authorization, заданное в дашборде рядом с URL вебхука.
# Обязательно в production: webhook работает fail-closed и без секрета возвращает 503.
TOOLKIN_REVENUECAT_WEBHOOK_SECRET=
# true — начислять кредиты и за sandbox-покупки. Только для отладки.
TOOLKIN_ALLOW_SANDBOX=false

# ─── Версии в сторах ─────────────────────────────────────────────────────────
# MIN_VERSION включает блокирующий экран «обновитесь» — нужен, только если
# сломан контракт API. В обычной ситуации оставляйте пустым.
# true — включить /api/dev/grant: начисление кредитов и премиума без оплаты
# для разработки в Expo Go. На проде обязан быть false, иначе это раздача денег.
TOOLKIN_ALLOW_DEV_GRANT=false

TOOLKIN_IOS_LATEST_VERSION=1.0.0
TOOLKIN_IOS_MIN_VERSION=
TOOLKIN_IOS_STORE_URL=https://apps.apple.com/app/id6799972749
TOOLKIN_IOS_RELEASE_NOTES=
TOOLKIN_ANDROID_LATEST_VERSION=1.0.0
TOOLKIN_ANDROID_MIN_VERSION=
TOOLKIN_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=store.evsi.toolkin
TOOLKIN_ANDROID_RELEASE_NOTES=
