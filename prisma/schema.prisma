generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Баланс живёт на сервере: кредиты расходуемые, и клиенту их считать нельзя.
// Ledger хранит каждую операцию, а уникальный eventId делает начисление по
// вебхуку RevenueCat идемпотентным — повторная доставка не начислит дважды.

model Account {
  id                  String   @id @default(cuid())
  appUserId           String   @unique // анонимный app_user_id из RevenueCat
  credits             Int      @default(0)
  welcomeGranted      Boolean  @default(false) // приветственные кредиты уже начислены
  premiumUntil        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  entries             Ledger[]
  generationJobs      GenerationJob[]

  @@index([premiumUntil])
}

model Ledger {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  delta     Int // отрицательное — списание, положительное — начисление
  reason    String // generate | refine | ask | welcome | purchase | subscription | grant | refund
  eventId   String?  @unique // id события RevenueCat
  meta      String? // JSON: число попыток генерации, product_id
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}

/// Кэш сгенерированных спек.
///
/// Один и тот же запрос — «калькулятор чаевых», «таймер для яиц» — приходит
/// от разных людей постоянно, а примеры-затравки на экране создания вообще
/// одинаковы у всех. Платить Gemini за повторную генерацию того же самого
/// незачем: спека детерминирована относительно запроса, языка и версии промпта.
model SpecCache {
  hash      String   @id // sha256(запрос + локаль + версия промпта)
  locale    String
  kind      String? // тип из этапа планирования, для статистики
  spec      String
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  usedAt    DateTime @updatedAt

  @@index([usedAt])
}


/// Durable asynchronous app-generation task. The mobile client creates a job
/// and polls its status instead of keeping one HTTP request open for minutes.
model GenerationJob {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status         String   @default("pending") // pending | running | completed | failed
  stage          String   @default("queued")  // queued | building | validating | repairing | finalizing | done
  prompt         String
  locale         String
  features       String   @default("[]") // JSON
  customFeatures String   @default("[]") // JSON
  planToken      String
  price          Int
  attempts       Int      @default(0)
  resultSpec     String?  // JSON
  resultMeta     String?  // JSON
  error          String?
  errorDetail    String?
  lockedAt       DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([accountId, createdAt])
  @@index([status, createdAt])
}
